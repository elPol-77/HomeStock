{
  "expo": {
    "name": "HomeStock",
    "slug": "homestock",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homestock",
    "userInterfaceStyle": "automatic",
    "description": "Inventario doméstico inteligente: caducidades, listas de la compra y comparador de precios.",
    "primaryColor": "#2E7A55",
    "ios": {
      "bundleIdentifier": "com.homestock.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "HomeStock usa la cámara para leer códigos de barras, fechas de caducidad y tickets.",
        "NSPhotoLibraryUsageDescription": "HomeStock usa tus fotos solo si eliges una imagen de un ticket o producto."
      }
    },
    "android": {
      "package": "com.homestock.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2E7A55",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1411"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HomeStock usa la cámara para leer códigos de barras, fechas de caducidad y tickets.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeStock usa tus fotos solo si eliges una imagen de un ticket o producto.",
          "cameraPermission": "HomeStock usa la cámara para fotografiar productos y tickets.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HomeStock usa tu ubicación aproximada solo para mostrar precios de tiendas cercanas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7A55"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
